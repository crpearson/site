  "planner_rules": {
    "series_order": [
      "C1",
      "C2",
      "C3",
      "C4"
    ],
    "channel_start_order": [
      1,
      2
    ],
    "skip_empty": true,
    "reorder": false,
    "include_states": [
      "active"
    ],
    "steps": [
      "Select the flown series and include every active pack in them. Empty and pulled slots are skipped: a pulled pack gets no storage charge, and nothing is reordered.",
      "Order each channel by series, then by pack number.",
      "On each charger, run Channel 1 and Channel 2 in rounds: start Channel 1, then Channel 2, and wait for both before the next round. When one channel is empty, the other continues alone.",
      "Count the files per charger: one log file per pack."
    ]
  },
  "start_order": {
    "rule": "On each charger, start Channel 1, then Channel 2, then wait for both to finish before the next round. When one channel runs out, the other carries on.",
    "mapping": "Logs map by charger, channel and order (one log file per pack)."
  },
